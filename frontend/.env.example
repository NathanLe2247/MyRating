# Copy to .env.local and fill in real values. Never commit .env.local.
#
# Next.js only exposes vars prefixed NEXT_PUBLIC_ to the browser bundle — so
# only put values here that are safe to ship to a client. R2 credentials
# (access key/secret) belong in backend/.env.local, not here.

# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL= https://<project-id>.supabase.co.eigyrdscekxoetqbidrr
NEXT_PUBLIC_SUPABASE_ANON_KEY= sb_publishable_TenlbLkKoMaD2Xk8s5Il6A_9ROK0TmV

# Public base URL for reading images out of the R2 bucket (via a Cloudflare
# public bucket domain or custom domain) — read-only, safe to expose.
NEXT_PUBLIC_R2_PUBLIC_URL=