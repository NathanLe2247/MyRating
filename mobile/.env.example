# Copy to .env.local and fill in real values. Never commit .env.local.
#
# Expo only exposes vars prefixed EXPO_PUBLIC_ to the client bundle — so only
# put values here that are safe to ship inside the app. R2 credentials
# (access key/secret) belong in backend/.env.local, not here: uploads should
# go through a signed URL issued by a backend function, never straight from
# the client with a secret key.

# Supabase project (Settings -> API in the Supabase dashboard). Still used
# for DB/Realtime access — auth itself is handled by Clerk below, with
# Supabase configured to accept Clerk-issued JWTs for RLS.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Clerk (Dashboard -> API Keys). Publishable key only — never put
# CLERK_SECRET_KEY in a client app.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Public base URL for reading images out of the R2 bucket (via a Cloudflare
# public bucket domain or custom domain) — read-only, safe to expose.
EXPO_PUBLIC_R2_PUBLIC_URL=
