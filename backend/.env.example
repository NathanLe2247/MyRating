# Copy to .env.local and fill in real values. Never commit .env.local.
#
# Used for local Supabase development (`supabase start`, `supabase functions
# serve --env-file backend/.env.local`). For deployed edge functions, push
# the same values with:
#   supabase secrets set --env-file backend/.env.local

# Supabase project (Settings -> API). Service role key bypasses RLS — only
# ever used server-side, inside edge functions.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (S3-compatible object storage) — court photos, avatars, etc.
# Account ID + R2 API token are created in the Cloudflare dashboard under
# R2 -> Manage API Tokens.
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# S3-compatible endpoint: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Public base URL if the bucket (or a custom domain) is exposed for reads —
# same value mobile's EXPO_PUBLIC_R2_PUBLIC_URL should point at.
R2_PUBLIC_URL=

# Clerk — mobile now authenticates via Clerk, with Supabase configured as a
# third-party auth provider (Authentication -> Sign In -> Third Party ->
# Clerk in the Supabase dashboard) so RLS can verify Clerk-issued JWTs.
# CLERK_SECRET_KEY is only needed here if an edge function calls Clerk's
# backend API directly (e.g. a webhook handler syncing new users into
# Postgres) — never expose it to a client.
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
