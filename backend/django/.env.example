# Copy to .env.local and fill in real values. Never commit .env.local.
#
# This service talks to Postgres directly (via DATABASE_URL), not through
# the Supabase client SDK the edge functions use.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Direct Postgres connection (Supabase project -> Settings -> Database ->
# Connection string). Prefer the pooled connection string for anything
# that isn't a one-off migration. Format:
#   postgres://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=

# Clerk — for verifying incoming request JWTs against Clerk's JWKS, and for
# calling Clerk's backend API if this service needs to (e.g. looking up a
# user). CLERK_SECRET_KEY is server-only, never expose it to a client.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
